# DeclineGuard Environment Variables
#
# Documentation: README.md, docs/lemon-squeezy-webhooks.md, docs/recovery-emails.md
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Never commit real secrets to version control.

# ─────────────────────────────────────────────────────────────────────────────
# Local Astro / Clerk (.env.local)
# ─────────────────────────────────────────────────────────────────────────────
# Clerk publishable key (starts with pk_test_ or pk_live_)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (starts with sk_test_ or sk_live_) — used by Astro middleware
CLERK_SECRET_KEY=sk_test_...

# Convex deployment URL (from Convex dashboard)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ─────────────────────────────────────────────────────────────────────────────
# Convex deployment env (set with: npx convex env set VAR_NAME "value")
# ─────────────────────────────────────────────────────────────────────────────
# These are NOT in .env.local — set them directly on your Convex deployment.
#
# --- Clerk ---
# CLERK_FRONTEND_API_URL — Clerk Frontend API URL for JWT verification
#   convex/auth.config.ts
#   npx convex env set CLERK_FRONTEND_API_URL "https://your-clerk-frontend-api.clerk.accounts.dev"
#
# CLERK_WEBHOOK_SECRET — Svix signing secret for Clerk webhooks → POST /clerk
#   convex/clerk.ts
#   npx convex env set CLERK_WEBHOOK_SECRET "whsec_..."
#
# CLERK_SECRET_KEY — Clerk Backend API key for admin actions
#   convex/functions/adminActions.ts, convex/functions/adminTakeoverActions.ts
#   npx convex env set CLERK_SECRET_KEY "sk_test_..."
#
# --- Lemon Squeezy ---
# LEMONSQUEEZY_WEBHOOK_SECRET — LS signing secret for POST /lemonsqueezy
#   convex/lemonWebhook.ts, docs/lemon-squeezy-webhooks.md
#   LS signing secret max length is 40 chars; hex 16 = 32 chars
#   npx convex env set LEMONSQUEEZY_WEBHOOK_SECRET "$(openssl rand -hex 16)"
#
# LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS — (optional) previous LS signing secret
#   Enables zero-downtime webhook secret rotation. During the rotation window:
#   1. Generate new secret and set as LEMONSQUEEZY_WEBHOOK_SECRET
#   2. Copy old secret to LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS
#   3. Update webhook secret in Lemon Squeezy dashboard
#   4. After LS retries settle (24-48h), remove LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS
#   Both secrets are verified (timing-safe); either validates the signature.
#   npx convex env set LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS "your-old-secret"
#
# LS_TOKEN_ENCRYPTION_KEY — 64 hex chars (32 bytes); encrypts per-merchant LS API keys at rest
#   convex/lib/lsCrypto.ts
#   npx convex env set LS_TOKEN_ENCRYPTION_KEY "$(openssl rand -hex 32)"
#
# --- Convex Site URL ---
# CONVEX_SITE_URL — usually built-in; base URL for webhook callbacks
#   convex/functions/lemonSqueezy.ts, convex/functions/lemonSqueezyActions.ts
#   Example: https://savory-antelope-128.convex.site
#
# --- Resend (email) ---
# RESEND_API_KEY — Resend API key for recovery emails (required)
#   convex/functions/recoveryEmails.ts
#   npx convex env set RESEND_API_KEY "re_..."
#
# RESEND_FROM_EMAIL — verified domain sender (optional until production)
#   convex/lib/recoveryEmailFrom.ts, docs/recovery-emails.md
#   npx convex env set RESEND_FROM_EMAIL "DeclineGuard <noreply@yourdomain.com>"
#
# RESEND_WEBHOOK_SECRET — Svix signing secret for Resend webhooks → POST /resend
#   convex/resendWebhook.ts, docs/recovery-emails.md
#   npx convex env set RESEND_WEBHOOK_SECRET "whsec_..."
#
# --- Dev-only ---
# RECOVERY_SEQUENCE_FAST — accelerated email schedule for dev (Day 0 → +1 min → +1 min)
#   docs/recovery-emails.md
#   npx convex env set RECOVERY_SEQUENCE_FAST 1
#   npx convex env remove RECOVERY_SEQUENCE_FAST  # unset for production delays
#
# --- Brand Capture Worker ---
# BRAND_CAPTURE_WORKER_URL — URL of the Playwright brand-capture worker
#   convex/lib/brandImport/browserCapture.ts
#   npx convex env set BRAND_CAPTURE_WORKER_URL "https://declineguard-brand-capture.fly.dev"
#
# BRAND_CAPTURE_WORKER_SECRET — shared secret for worker auth
#   convex/lib/brandImport/browserCapture.ts
#   npx convex env set BRAND_CAPTURE_WORKER_SECRET "your-secret-here"

# ─────────────────────────────────────────────────────────────────────────────
# Fly brand-capture worker (fly.brand-capture.toml, scripts/brand-capture-worker.ts)
# ─────────────────────────────────────────────────────────────────────────────
# These are set on Fly.io (fly secrets set …), not in .env.local or Convex.
#
# BRAND_CAPTURE_WORKER_SECRET — same secret as Convex env above
#   fly secrets set BRAND_CAPTURE_WORKER_SECRET="your-secret-here"
#
# Built-in via fly.brand-capture.toml:
#   REQUIRE_SECRET=1
#   NODE_ENV=production
#   PORT=8787
