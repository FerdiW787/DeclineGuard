---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";

const source = readFileSync(
  join(process.cwd(), "docs/admin-recovery-console.md"),
  "utf8",
);

/** Turn `## Title {#slug}` into HTML headings with stable ids for deep links. */
const withExplicitIds = source.replace(
  /^(#{1,6})\s+(.+?)\s+\{#([a-z0-9-]+)\}\s*$/gm,
  (_match, hashes: string, title: string, id: string) => {
    const level = hashes.length;
    return `<h${level} id="${id}">${title}</h${level}>`;
  },
);

const html = await marked.parse(withExplicitIds, {
  gfm: true,
  breaks: false,
});

const toc = [
  { href: "#overview", label: "Overview" },
  { href: "#roles", label: "Roles" },
  { href: "#live-log", label: "Live log" },
  { href: "#statuses", label: "Statuses" },
  { href: "#freeze", label: "Freeze" },
  { href: "#kick-sessions", label: "Kick sessions" },
  { href: "#restore", label: "Restore" },
  { href: "#reclaim", label: "Give store back" },
  { href: "#unlock", label: "Unlock" },
  { href: "#ban", label: "Ban" },
  { href: "#playbooks", label: "Playbooks" },
];
---

<Layout
  title="Staff guide — DeclineGuard"
  description="What every admin recovery action does, who it affects, and when to use it."
>
  <div class="ln-surface min-h-screen bg-[#08090a] text-[#f7f8f8]">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-[#08090a]/95 backdrop-blur-sm">
      <div
        class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-5 md:px-8"
      >
        <a
          href="/a/admin"
          class="text-sm font-medium text-white/50 transition hover:text-white"
        >
          ← Back to admin
        </a>
        <div class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.08em] text-white/45">
          <span>Recovery guide</span>
          <a href="/a/admin/docs/support" class="hover:text-white">Support guide</a>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 py-8 md:px-8 md:py-10">
      <nav
        class="mb-10 flex flex-wrap gap-2 border-b border-black/[0.08] pb-6"
        aria-label="On this page"
      >
        {
          toc.map((item) => (
            <a
              href={item.href}
              class="rounded-lg border border-black/10 bg-black/[0.03] px-2.5 py-1 text-[12px] font-medium text-black/65 transition hover:border-black/20 hover:bg-black/[0.05] hover:text-black"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <article class="admin-guide-prose" set:html={html} />
    </div>
  </div>
</Layout>

<style is:global>
  .admin-guide-prose {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(0, 0, 0, 0.78);
  }

  .admin-guide-prose > :first-child {
    margin-top: 0;
  }

  .admin-guide-prose h1,
  .admin-guide-prose h2,
  .admin-guide-prose h3 {
    font-family: var(--font-display, inherit);
    color: #0c0c0c;
    letter-spacing: -0.02em;
    scroll-margin-top: 5.5rem;
  }

  .admin-guide-prose h1 {
    font-size: 1.75rem;
    margin: 0 0 0.75rem;
  }

  .admin-guide-prose h2 {
    font-size: 1.35rem;
    margin: 2.25rem 0 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .admin-guide-prose h2:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .admin-guide-prose h3 {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }

  .admin-guide-prose p {
    margin: 0.65rem 0;
  }

  .admin-guide-prose blockquote {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid rgba(0, 0, 0, 0.15);
    background: rgba(0, 0, 0, 0.02);
    color: rgba(0, 0, 0, 0.6);
  }

  .admin-guide-prose blockquote p {
    margin: 0.35rem 0;
  }

  .admin-guide-prose ul,
  .admin-guide-prose ol {
    margin: 0.65rem 0;
    padding-left: 1.25rem;
  }

  .admin-guide-prose li {
    margin: 0.25rem 0;
  }

  .admin-guide-prose code {
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 0.3rem;
    padding: 0.1rem 0.35rem;
  }

  .admin-guide-prose pre {
    margin: 1rem 0;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: #0c0c0c;
    color: #f5f5f5;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .admin-guide-prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .admin-guide-prose table {
    width: 100%;
    margin: 1rem 0;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-guide-prose th,
  .admin-guide-prose td {
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }

  .admin-guide-prose th {
    background: rgba(0, 0, 0, 0.03);
    font-weight: 600;
  }

  .admin-guide-prose hr {
    margin: 1.75rem 0;
    border: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .admin-guide-prose strong {
    color: #0c0c0c;
    font-weight: 600;
  }

  .admin-guide-prose a {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
