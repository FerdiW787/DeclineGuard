---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import "@/styles/admin-guide.css";

const source = readFileSync(
  join(process.cwd(), "docs/admin-recovery-console.md"),
  "utf8",
);

/** Turn `## Title {#slug}` into HTML headings with stable ids for deep links. */
const withExplicitIds = source.replace(
  /^(#{1,6})\s+(.+?)\s+\{#([a-z0-9-]+)\}\s*$/gm,
  (_match, hashes: string, title: string, id: string) => {
    const level = hashes.length;
    return `<h${level} id="${id}">${title}</h${level}>`;
  },
);

const html = await marked.parse(withExplicitIds, {
  gfm: true,
  breaks: false,
});

const toc = [
  { href: "#overview", label: "Overview" },
  { href: "#roles", label: "Roles" },
  { href: "#live-log", label: "Live log" },
  { href: "#statuses", label: "Statuses" },
  { href: "#freeze", label: "Freeze" },
  { href: "#kick-sessions", label: "Kick sessions" },
  { href: "#restore", label: "Restore" },
  { href: "#reclaim", label: "Give store back" },
  { href: "#unlock", label: "Unlock" },
  { href: "#ban", label: "Ban" },
  { href: "#playbooks", label: "Playbooks" },
];
---

<Layout
  theme="light"
  title="Staff guide — DeclineGuard"
  description="What every admin recovery action does, who it affects, and when to use it."
  showScrollbar
>
  <div class="ln-surface min-h-screen bg-[#f7f8f8] text-[#08090a]">
    <header
      class="sticky top-0 z-20 border-b border-black/8 bg-[#f7f8f8]/90 backdrop-blur-xl"
    >
      <div
        class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-5 md:px-8"
      >
        <a
          href="/a/admin"
          class="text-sm font-medium text-[#8a8f98] transition hover:text-[#08090a]"
        >
          ← Staff console
        </a>
        <div
          class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8a8f98]"
        >
          <span class="text-[#08090a]">Recovery</span>
          <a href="/a/admin/docs/support" class="hover:text-[#08090a]"
            >Support</a
          >
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 py-8 md:px-8 md:py-10">
      <p
        class="text-xs font-semibold uppercase tracking-[0.16em] text-[#8a8f98]"
      >
        Guides
      </p>
      <h1 class="font-display mt-2 text-3xl tracking-tight md:text-4xl">
        Recovery console
      </h1>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#6b6f76]">
        What every recovery action does, who it affects, and when to use it.
      </p>

      <nav
        class="mt-8 mb-8 flex flex-wrap gap-2"
        aria-label="On this page"
      >
        {
          toc.map((item) => (
            <a
              href={item.href}
              class="rounded-full border border-black/8 bg-white px-2.5 py-1 text-[12px] font-medium text-[#6b6f76] transition hover:border-black/16 hover:text-[#08090a]"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <article
        class="admin-guide-prose rounded-2xl border border-black/8 bg-white px-5 py-7 md:px-8 md:py-8"
        set:html={html}
      />
    </div>
  </div>
</Layout>
