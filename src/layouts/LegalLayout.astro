---
import Layout from "@/layouts/Layout.astro";
import { legal, legalNav } from "@/lib/legal";

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
}

const { title, description, heading, eyebrow = "Legal" } = Astro.props;
---

<Layout title={`${title} — ${legal.brandName}`} description={description} theme="light" showScrollbar>
  <div class="ln-surface flex min-h-svh flex-col bg-background text-foreground">
    <header class="shrink-0 border-b border-border">
      <div
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-5 md:px-8"
      >
        <a
          href="/"
          class="text-lg font-semibold tracking-tight text-foreground hover:text-foreground"
        >
          {legal.brandName}
        </a>
        <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {
            legalNav.map((item) => (
              <a href={item.href} class="text-muted-foreground hover:text-foreground">
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12 md:px-8 md:py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
        {eyebrow}
      </p>
      <h1 class="ln-h1 mt-3 text-3xl font-medium tracking-tight md:text-4xl">
        {heading}
      </h1>
      <p class="mt-3 text-sm text-muted-foreground">
        Effective: {legal.effectiveDate} · Last updated: {legal.lastUpdated}
      </p>

      <aside
        class="mt-8 rounded-lg border border-border bg-white px-4 py-3 text-sm text-muted-foreground"
      >
        <strong class="font-semibold text-foreground">Fill before launch:</strong> replace all
        bracketed placeholders in
        <code class="rounded bg-black/[0.05] px-1">src/lib/legal.ts</code> (company
        name, address, emails, register, VAT). Have a qualified EU/DE lawyer
        review these drafts before you go live.
      </aside>

      <article class="legal-prose mt-10">
        <slot />
      </article>
    </main>

    <footer class="mt-auto shrink-0 border-t border-border">
      <div
        class="mx-auto flex max-w-3xl flex-col gap-3 px-6 py-8 text-sm text-muted-foreground md:px-8"
      >
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {
            legalNav.map((item) => (
              <a href={item.href} class="hover:text-foreground">
                {item.label}
              </a>
            ))
          }
          <a href="/" class="hover:text-foreground">Home</a>
        </div>
        <p>
          © {new Date().getFullYear()}
          {" "}
          {legal.brandName} · {legal.legalName}
        </p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  .legal-prose h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }
  .legal-prose h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .legal-prose p,
  .legal-prose li {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .legal-prose p + p {
    margin-top: 0.85rem;
  }
  .legal-prose ul,
  .legal-prose ol {
    margin: 0.75rem 0 0.75rem 1.25rem;
  }
  .legal-prose ul {
    list-style: disc;
  }
  .legal-prose ol {
    list-style: decimal;
  }
  .legal-prose li + li {
    margin-top: 0.35rem;
  }
  .legal-prose a {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose a:hover {
    color: var(--primary-foreground);
  }
  .legal-prose strong {
    font-weight: 600;
    color: var(--foreground);
  }
  .legal-prose table {
    width: 100%;
    margin: 1rem 0;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .legal-prose th,
  .legal-prose td {
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose th {
    background: rgba(0, 0, 0, 0.03);
    font-weight: 600;
    color: var(--foreground);
  }
</style>
